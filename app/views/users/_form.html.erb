<%= form_with(model: user) do |form| %>
<% if user.errors.any? %><div class="errors" role="alert"><h2>Перевір введені дані</h2><ul><% user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
<%= form.label :name, "Ім’я" %><%= form.text_field :name, required: true, maxlength: 100 %>
<%= form.label :email, "Електронна пошта" %><%= form.email_field :email, required: true %><div><%= form.submit "Зберегти" %></div><% end %>